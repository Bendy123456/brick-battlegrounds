{
  "name": "airsoft-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config client/vite.config.ts",
    "start": "node --import tsx server/src/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1",
    "ws": "^8.18.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
